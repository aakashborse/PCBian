# Required for the AI copilot. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: override the model used by the copilot
PCBIAN_MODEL=claude-opus-5-5
# Server port (the Vite dev server proxies /api and /yjs here)
PORT=8787
# Optional: live prices, stock and lifecycle in the BOM (Mouser search API key)
MOUSER_API_KEY=
